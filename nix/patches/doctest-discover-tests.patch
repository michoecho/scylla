 set(properties ${TEST_PROPERTIES})
@@ -36,7 +39,7 @@ if("${spec}" MATCHES .)
 endif()
 
 execute_process(
-  COMMAND ${TEST_EXECUTOR} "${TEST_EXECUTABLE}" ${spec} --list-test-cases
+  COMMAND ${TEST_EXECUTOR} "${TEST_EXECUTABLE}" ${subcommand} ${spec} --list-test-cases
   OUTPUT_VARIABLE output
   RESULT_VARIABLE result
   WORKING_DIRECTORY "${TEST_WORKING_DIR}"
@@ -51,6 +54,36 @@ endif()
 
 string(REPLACE "\n" ";" output "${output}")
 
+# Ask again for the source location of each case, via the project's
+# `test-locations` reporter (src/test_locations_reporter.cc). It emits two
+# lines per case -- name, then file:line -- which the loop below looks up by
+# name to set DEF_SOURCE_LINE.
+#
+# The reporter exists so this stays a lookup rather than a parse: doctest's
+# built-in xml reporter carries the same data, but reading it from CMake means
+# a regex over attribute order and XML entity escaping, for information that
+# was structured before it was serialized.
+#
+# Deliberately kept as one opaque string rather than split into a list. A test
+# name may contain a semicolon, and CMake list operations would read that as an
+# element separator no matter how the list was built -- desynchronizing the
+# name/location pairing for every case after it.
+#
+# Best-effort: a runner without the reporter linked in treats --reporters as
+# naming an unknown reporter, which doctest reports by printing nothing and
+# exiting 0. That yields no locations, so every test simply keeps the
+# properties it had before -- discovery of the tests themselves is unaffected,
+# since it is the separate plain-text listing above that enumerates them.
+execute_process(
+  COMMAND ${TEST_EXECUTOR} "${TEST_EXECUTABLE}" ${subcommand} ${spec} --list-test-cases --reporters=test-locations
+  OUTPUT_VARIABLE locations
+  RESULT_VARIABLE locresult
+  WORKING_DIRECTORY "${TEST_WORKING_DIR}"
+)
+if(NOT ${locresult} EQUAL 0)
+  set(locations "")
+endif()
+
 # Parse output
 foreach(line ${output})
   if("${line}" STREQUAL "===============================================================================" OR "${line}" MATCHES [==[^\[doctest\] ]==])
@@ -61,7 +94,7 @@ foreach(line ${output})
   if(${add_labels})
     # get test suite that test belongs to
     execute_process(
-      COMMAND ${TEST_EXECUTOR} "${TEST_EXECUTABLE}" --test-case=${test} --list-test-suites
+      COMMAND ${TEST_EXECUTOR} "${TEST_EXECUTABLE}" ${subcommand} --test-case=${test} --list-test-suites
       OUTPUT_VARIABLE labeloutput
       RESULT_VARIABLE labelresult
       WORKING_DIRECTORY "${TEST_WORKING_DIR}"
@@ -97,14 +130,62 @@ foreach(line ${output})
     "${prefix}${test}${suffix}"
     ${TEST_EXECUTOR}
     "${TEST_EXECUTABLE}"
+    ${subcommand}
     "--test-case=${test_name}"
     "${TEST_JUNIT_OUTPUT_PARAM}"
     ${extra_args}
   )
+  # DEF_SOURCE_LINE is what the VS Code CMake Tools test explorer reads to make
+  # "go to test" jump to the case, matching what gtest_discover_tests sets.
+  # Omitted entirely when the location is unknown, rather than set to a bogus
+  # value the IDE would try to open.
+  #
+  # Found by matching "<name>\n<location>\n" in the reporter output. The name is
+  # an arbitrary user string being spliced into a regex, so its metacharacters
+  # are escaped first; the leading newline is prepended to the subject so the
+  # very first record anchors like every other one.
+  set(def_source_line "")
+  string(REGEX REPLACE "([][+.*()^$?|\\\\])" "\\\\\\1" test_regex "${test}")
+  if("\n${locations}" MATCHES "\n${test_regex}\n([^\n]+)\n")
+    set(def_source_line DEF_SOURCE_LINE "${CMAKE_MATCH_1}")
+  endif()
+
+  # PROFILE_DIR opts this runner's cases into per-test coverage: each one gets
+  # its own LLVM_PROFILE_FILE, so the .profraw files it produces name the CTest
+  # test that produced them rather than only the binary and the PID.
+  #
+  # The filename is a hash of the full CTest name, not the name itself. Case
+  # names are arbitrary user strings -- spaces, slashes, quotes, and the `:::`
+  # this project's TEST_PREFIX adds -- so any direct spelling needs an escaping
+  # scheme that both this file and tools/merge-coverage agree on, and that still
+  # loses to names colliding once sanitized. A hash sidesteps the encoding
+  # question entirely; the id is opaque and the manifest written below is what
+  # carries the real name back to the reader.
+  #
+  # MD5 because it is what CMake offers here and this is a filename, not a
+  # security boundary.
+  #
+  # %p%m is kept after the id. The id identifies the test; %p%m is what keeps
+  # writers unique -- a test that spawns subprocesses has several of them, and
+  # each needs its own file. tools/merge-coverage groups back to the id by
+  # stripping exactly that suffix.
+  set(profile_property "")
+  if(profile_dir)
+    string(MD5 profile_id "${prefix}${test}${suffix}")
+    set(profile_property ENVIRONMENT_MODIFICATION
+      "LLVM_PROFILE_FILE=set:${profile_dir}/${profile_id}.%p%m.profraw")
+    # One `<id> <ctest name>` record per line. The name is last so that it may
+    # contain spaces without needing to be quoted; the id is a fixed-width hash,
+    # so a reader splits on the first space and takes the rest verbatim.
+    string(APPEND profile_manifest "${profile_id} ${prefix}${test}${suffix}\n")
+  endif()
+
   add_command(set_tests_properties
     "${prefix}${test}${suffix}"
     PROPERTIES
     WORKING_DIRECTORY "${TEST_WORKING_DIR}"
+    ${def_source_line}
+    ${profile_property}
     ${properties}
     LABELS ${labels}
   )
@@ -118,3 +198,17 @@ add_command(set ${TEST_LIST} ${tests})
 
 # Write CTest script
 file(WRITE "${CTEST_FILE}" "${script}")
+
+# The sidecar mapping profile-file id -> CTest test name, for whoever reads the
+# .profraw files back (tools/merge-coverage). Written per discovered runner,
+# named after the CTest script so that two runners discovered into the same
+# PROFILE_DIR cannot overwrite each other's manifest; the reader concatenates
+# every *.manifest it finds.
+#
+# Written unconditionally when PROFILE_DIR is set, including when it would be
+# empty, so that a stale manifest from a previous configure -- listing tests
+# that no longer exist -- is truncated rather than left behind.
+if(profile_dir)
+  get_filename_component(manifest_name "${CTEST_FILE}" NAME_WE)
+  file(WRITE "${profile_dir}/${manifest_name}.manifest" "${profile_manifest}")
+endif()
