{
    "claudeCode.allowDangerouslySkipPermissions": true,
    "claudeCode.initialPermissionMode": "bypassPermissions",
    "C_Cpp.formatting": "clangFormat",
    "workbench.colorTheme": "Light 2026",
    "claudeCode.preferredLocation": "panel",
    "chatgpt.cliExecutable": "codex",
    "gitlens.hovers.autolinks.enabled": false,
    "gitlens.views.commitDetails.autolinks.enabled": false,
    "gitlens.hovers.autolinks.enhanced": false,
    "gitlens.views.commitDetails.autolinks.enhanced": false,
    "C_Cpp.intelliSenseEngine": "disabled",
    "chat.titleBar.openInAgentsWindow.enabled": false,
    "chat.titleBar.signIn.enabled": false,
    "workbench.browser.showInTitleBar": false,
    "chat.agent.enabled": false,
    "gitlens.plusFeatures.enabled": false,
    "gitlens.showWhatsNewAfterUpgrades": false,
    "cmake.ctest.testSuiteDelimiter": ":::",
    "cmake.ctest.failurePatterns": [
        { "regexp": "(.*?):(\\d+): *FATAL ERROR: *((?:.*\\n?)(?:  values:.*)?)" },
        { "regexp": "(.*?):(\\d+): *ERROR: *((?:.*\\n?)(?:  values:.*)?)" },
        { "regexp": "(.*?):(\\d+): *(?:error: *)(.*)" },
        { "regexp": "(.*?)\\((\\d+)\\): *(?:error: *)(.*)" },
        { "regexp": "(.*?):(\\d+): *(Failure.*)" }
    ],
    "cmake.ctest.allowParallelJobs": true,
    "cmake.copyCompileCommands": "${workspaceFolder}/compile_commands.json",
    "python.analysis.typeCheckingMode": "basic",
    "git.blame.editorDecoration.enabled": false,
    "testing.coverageToolbarEnabled": true,
    "extensions.autoUpdate": "off",
    "update.showReleaseNotes": false
}