#!/usr/bin/env python3
"""Validate and optionally remove orphaned file-backed snapshots."""

import argparse
import re
import subprocess
import sys
from collections import defaultdict
from pathlib import Path

UUID = r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
SOURCE_GLOBS = ("*.cc", "*.cpp", "*.cxx", "*.h", "*.hh", "*.hpp", "*.hxx")

# rg searches for this fixed string and nothing more; everything structural is
# decided here, against the text preceding each hit. Deliberately not a C++
# parser: this validator only exists to catch developer mistakes in tests, and
# scanning the whole repo with a real parser cost seconds.
NEEDLE = '"_filesnap'

# A reference: the closing quote is preceded by a canonical UUID.
REFERENCE_RE = re.compile(rf'"{UUID}$')

# `operator""_filesnap` declares the literal rather than using it. Recognised
# explicitly, so that a genuinely malformed reference still gets reported.
OPERATOR_RE = re.compile(r'operator\s*"$')

# Files where `"_filesnap` appears in neither form: as a plain string, or with
# escaped quotes inside a C++ string literal used as test data. Both are the
# snapshot mechanism's own sources reasoning about the syntax, and neither is
# something the line-wise scan can tell apart from the real thing.
SKIP = ("modules/snapshot/updater.cc", "modules/snapshot/updater_test.cc")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", type=Path, default=Path.cwd())
    parser.add_argument("--cleanup", action="store_true",
                        help="delete orphan files if they are the only problems")
    args = parser.parse_args()
    root = args.root.resolve()
    snapshot_root = root / ".snapshots"
    references = defaultdict(list)
    problems = []

    # rg skips .gitignore'd trees (out/, and whatever else the repo ignores)
    # for free, which is what keeps this fast; .snapshots is tracked, so it
    # needs excluding by hand. --with-filename/--line-number keep the output
    # unambiguous even when only one file matches, and --column is what lets
    # the loop below look at the text preceding each hit.
    command = ["rg", "--fixed-strings", "--no-heading", "--with-filename",
               "--line-number", "--column", "--glob", "!.snapshots/**"]
    for glob in SOURCE_GLOBS:
        command += ["--glob", glob]
    for skip in SKIP:
        command += ["--glob", f"!{skip}"]
    command += [NEEDLE, "."]

    # Run from the root and search ".", rather than passing it as the path: a
    # glob with a "/" in it anchors to the working directory, so SKIP's paths
    # would silently match nothing. It also makes rg report relative paths.
    result = subprocess.run(command, cwd=root, text=True, capture_output=True)
    # 0 = matches, 1 = none (a clean repo with no snapshots at all); 2 = error.
    if result.returncode >= 2:
        print(result.stderr.strip(), file=sys.stderr)
        return 1

    for entry in result.stdout.splitlines():
        path_text, line, column, text = entry.split(":", 3)
        location = f"{Path(path_text).relative_to('.')}:{line}"
        # --column is 1-based and points at the quote the needle starts with,
        # so this is the text before it: for a reference, the opening quote and
        # the UUID.
        before = text[:int(column) - 1]
        match = REFERENCE_RE.search(before)
        if match:
            references[match.group()[1:]].append(location)
        elif not OPERATOR_RE.search(before):
            problems.append(f"{location}: _filesnap is not immediately preceded by a quoted canonical UUID")

    for uuid, locations in sorted(references.items()):
        if len(locations) > 1:
            problems.append(f"duplicate {uuid}: " + ", ".join(locations))
        expected = snapshot_root / uuid[:2] / f"{uuid}.snap"
        if not expected.is_file():
            problems.append(f"missing {expected.relative_to(root)} referenced by {locations[0]}")

    orphans = []
    if snapshot_root.exists():
        for path in snapshot_root.rglob("*.snap"):
            relative = path.relative_to(snapshot_root)
            match = re.fullmatch(rf"([0-9a-f]{{2}})/({UUID})\.snap", str(relative))
            if not match or match.group(1) != match.group(2)[:2]:
                problems.append(f"malformed snapshot path {path.relative_to(root)}")
            elif match.group(2) not in references:
                orphans.append(path)

    if orphans and args.cleanup and not problems:
        for path in orphans:
            path.unlink()
            print(f"removed {path.relative_to(root)}")
        for directory in sorted(snapshot_root.rglob("*"), reverse=True):
            if directory.is_dir():
                try: directory.rmdir()
                except OSError: pass
        return 0
    problems.extend(f"orphan {path.relative_to(root)}" for path in orphans)
    if problems:
        print("\n".join(problems), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
