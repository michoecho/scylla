#!/usr/bin/env python3

import argparse
import glob
import json
import logging
import os
import re
import subprocess
from pathlib import Path

def get_build_id(file_path):
    """Extracts the build-id from an ELF file using readelf."""
    try:
        # The -n option displays notes, which includes the build-id.
        result = subprocess.run(
            ["readelf", "-n", file_path],
            capture_output=True,
            text=True,
            check=True,
            errors='ignore', # Ignore non-UTF8 characters in readelf output
        )
        # The build-id is usually on a line like "    Build ID: aabbcc..."
        match = re.search(r"Build ID:\s*([0-9a-fA-F]+)", result.stdout)
        if match:
            return match.group(1)
    except (subprocess.CalledProcessError, FileNotFoundError):
        # Ignore errors for non-ELF files or if readelf is not found.
        pass
    return None

buildid_regex = re.compile(r"[0-9a-fA-F]+")

def get_profdata_build_ids(profdata_file):
    """Extracts all binary build-ids from a .profdata file."""
    try:
        result = subprocess.run(
            ["llvm-profdata", "show", "--binary-ids", profdata_file],
            capture_output=True,
            text=True,
            check=True,
        )
        # The output is a list of build-ids, one per line.
        lines = [l.strip() for l in result.stdout.strip().split("\n") if l.strip()]
        return [line for line in lines if buildid_regex.fullmatch(line)]
    except (subprocess.CalledProcessError, FileNotFoundError) as e:
        logging.warning(f"Failed to read build-ids from {profdata_file}: {e}")
        return []

def run_command(cmd):
    """Logs and runs a command, checking for errors."""
    logging.info(" ".join(map(str, cmd)))
    subprocess.run(cmd, check=True)

def read_profile_manifests(profile_dir):
    """Maps profile-file id -> CTest test name.

    Test discovery writes one `<id> <ctest name>` record per line, in a
    `*.manifest` file per discovered runner (see
    nix/patches/doctest-discover-tests.patch, plus python.manifest from the root
    CMakeLists). Split on the first space only: the id is a fixed-width hash and
    the name is an arbitrary user string that may contain spaces.
    """
    manifest = {}
    for path in sorted(Path(profile_dir).glob("*.manifest")):
        for line in path.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if not line:
                continue
            profile_id, _, test_name = line.partition(" ")
            if test_name:
                manifest[profile_id] = test_name
    return manifest

# A per-test .profraw is `<id>.<pid><merge-pool>.profraw`, with the id a hash of
# the CTest test name. The suffix is what llvm's %p%m expands to, so stripping it
# groups every process a single test spawned back onto that test.
per_test_profraw_regex = re.compile(r"([0-9a-fA-F]{32})\.[^.]*\.profraw")

def export_per_test_lcov(profile_dir, manifest, buildid_dir):
    """Writes coverage/per-test/<id>.lcov, one per test that produced profiles.

    Runs after the total report, so it can reuse the .build-id symlink farm the
    total pass builds: --debug-file-directory is how llvm-cov finds the binaries
    a profile came from, and every binary in the suite is already registered
    there. That also means a per-test export needs no build-id lookup of its own
    -- one llvm-cov invocation per test covers whichever binaries that test ran,
    including a python test that spawned several.
    """
    groups = {}
    for path in Path(profile_dir).glob("*.profraw"):
        match = per_test_profraw_regex.fullmatch(path.name)
        if match:
            groups.setdefault(match.group(1), []).append(str(path))

    if not groups:
        logging.warning(
            f"--per-test: no per-test .profraw files in {profile_dir}. "
            "Was the suite run with an ENABLE_TEST_COVERAGE build?"
        )
        return

    out_dir = Path("coverage/per-test")
    out_dir.mkdir(parents=True, exist_ok=True)

    exported = {}
    for profile_id, profraws in sorted(groups.items()):
        test_name = manifest.get(profile_id)
        if test_name is None:
            # A profile whose test is not in any manifest: most likely left over
            # from a test that has since been renamed or deleted. Reporting it
            # under its hash would attribute coverage to a test the extension
            # cannot resolve, so skip it and say so.
            logging.warning(
                f"--per-test: no manifest entry for {profile_id}, skipping "
                "(stale profile from a renamed or deleted test?)"
            )
            continue

        profdata = str(out_dir / f"{profile_id}.profdata")
        run_command(
            ["llvm-profdata", "merge", "-sparse", "-o", profdata] + sorted(profraws)
        )
        lcov_path = out_dir / f"{profile_id}.lcov"
        with open(lcov_path, "w") as lcov_file:
            logging.info(f"llvm-cov export -> {lcov_path}")
            subprocess.run(
                [
                    "llvm-cov", "export",
                    "--format=lcov",
                    "--check-binary-ids",
                    "--debug-file-directory", buildid_dir,
                    f"-instr-profile={profdata}",
                ],
                stdout=lcov_file,
                check=True,
            )
        exported[profile_id] = test_name

    # The manifest the reader actually consumes: only the tests that have an
    # .lcov beside it, so a consumer never has to handle a named test with no
    # report. JSON because its consumer is the VS Code extension, not CMake.
    manifest_path = out_dir / "manifest.json"
    manifest_path.write_text(
        json.dumps(
            {"tests": [{"id": i, "test": n, "lcov": f"{i}.lcov"}
                       for i, n in sorted(exported.items(), key=lambda kv: kv[1])]},
            indent=2,
        ) + "\n",
        encoding="utf-8",
    )
    logging.info(f"Wrote {manifest_path} ({len(exported)} tests)")

def main():
    """Main function to parse arguments and run coverage merging."""
    parser = argparse.ArgumentParser(
        description="Merge LLVM coverage data and generate reports."
    )
    parser.add_argument(
        "target_dir",
        nargs="?",
        default=".",
        help="Target directory to process (positional)."
    )
    parser.add_argument(
        "-v", "--verbose", action="store_true", help="Enable verbose logging."
    )
    parser.add_argument(
        "--per-test",
        action="store_true",
        help="Also export one LCOV file per CTest test into coverage/per-test/.",
    )
    parser.add_argument(
        "--profile-dir",
        help="Directory holding the per-test .profraw files and the id->test-name "
             "manifests written by test discovery. Required with --per-test.",
    )
    args = parser.parse_args()

    if args.per_test and not args.profile_dir:
        parser.error("--per-test requires --profile-dir")

    # Configure logging
    log_level = logging.DEBUG if args.verbose else logging.INFO
    logging.basicConfig(
        level=log_level, format="%(levelname)s: %(message)s", datefmt="%H:%M:%S"
    )

    # Resolved before the chdir below, which would otherwise reinterpret a
    # relative --profile-dir against the target directory.
    profile_dir = Path(args.profile_dir).resolve() if args.profile_dir else None

    # Immediately change working directory to the target directory.
    try:
        os.chdir(args.target_dir)
        logging.debug(f"Changed working directory to: {args.target_dir}")
    except OSError as e:
        logging.error(f"Could not change directory to {args.target_dir}: {e}")
        raise SystemExit(1)

    # 1. Find all executable ELF files and map their build-ids to paths.
    logging.info("--- Finding executables and build-ids ---")
    build_id_map = {}
    # Search for any file in the current directory and subdirectories.
    for path_str in glob.glob("**/*", recursive=True):
        path = Path(path_str)
        # Check if it's a file and has execute permissions.
        if path.is_file() and not path.is_symlink() and os.access(path, os.X_OK):
            build_id = get_build_id(path)
            if build_id:
                build_id_map[build_id] = path
                logging.debug(f"Found ELF: {path} (Build ID: {build_id})")

    # Find and group all .profraw files.
    profraws = glob.glob("**/*.profraw", recursive=True)
    pattern = r"(.*)\.[^.]*.profraw"
    expr = re.compile(pattern)
    groups = {}
    for p in profraws:
        x = expr.fullmatch(p)
        if x:
            base = x.group(1)
            groups.setdefault(base, []).append(p)
    logging.info(f"Found files:\n{"\n".join(profraws)}")

    common_llvm_cov_show_opts = [
        "llvm-cov",
        "show",
        "-format=html",
        "--show-branches=count",
        "--show-regions",
        "--show-line-counts-or-regions",
    ]

    # The id -> CTest name mapping, read once and shared by the HTML grouping
    # below and the LCOV export at the end. Read even without --per-test,
    # because the HTML report names its directories from it: profile files are
    # named by hash now, so without this every directory here would be an opaque
    # 32-character string.
    profile_manifest = read_profile_manifests(profile_dir) if profile_dir else {}

    # 2. Generate coverage reports for each test executable group.
    logging.info("\n--- Generating per-test coverage reports ---")
    for base, ps in groups.items():
        profdata_file = f"{base}.profdata"
        # Merge profraw files for the current group.
        cmd = ["llvm-profdata", "merge", "-sparse", "-o", profdata_file] + ps
        run_command(cmd)

        # The directory this group's HTML report goes under. A per-test profile
        # is named by hash, so prefer the test name the manifest gives back;
        # sanitized, because it is a directory component and a doctest case name
        # may contain slashes and worse. Anything not in the manifest (a profile
        # written by something other than a discovered test) keeps the old
        # filename-stem behaviour.
        group_name = Path(base).name
        test_name = profile_manifest.get(group_name)
        if test_name is not None:
            group_name = re.sub(r"[^-.\w]+", "_", test_name)

        # Get build-ids of all binaries involved in this test run.
        binary_build_ids = get_profdata_build_ids(profdata_file)
        for build_id in binary_build_ids:
            if build_id in build_id_map:
                binary_path = build_id_map[build_id]
                # Sanitize binary name for use in directory path.
                binary_name_sanitized = Path(binary_path.name).stem
                output_dir = f"coverage/{group_name}/{binary_name_sanitized}"
                # Generate coverage for this specific binary.
                cmd = [
                    *common_llvm_cov_show_opts,
                    str(binary_path),
                    f"-instr-profile={profdata_file}",
                    f"-output-dir={output_dir}"
                ]
                run_command(cmd)
            else:
                logging.warning(f"Could not find binary for build-id {build_id}")

    # 3. Merge all raw profiles and generate total coverage for each ELF.
    if profraws:
        logging.info("\n--- Generating total coverage report ---")
        total_profdata = "total.profdata"
        cmd = ["llvm-profdata", "merge", "-sparse", "-o", total_profdata] + profraws
        run_command(cmd)

        # Get build-ids of all binaries involved in the entire suite.
        total_build_ids = get_profdata_build_ids(total_profdata)
        binary_paths = []
        for build_id in total_build_ids:
            if build_id in build_id_map:
                binary_path = build_id_map[build_id]
                binary_paths.append(binary_path)
                binary_name_sanitized = Path(binary_path.name).stem
                output_dir = f"coverage/total/{binary_name_sanitized}"
                # Generate total coverage for this binary.
                cmd = [
                    *common_llvm_cov_show_opts,
                    str(binary_path),
                    f"-instr-profile={total_profdata}",
                    f"-output-dir={output_dir}"
                ]
                run_command(cmd)
            else:
                logging.warning(f"Could not find binary for build-id {build_id}")
        buildid_dir = "coverage"
        os.makedirs(buildid_dir, exist_ok=True)
        for build_id in total_build_ids:
            os.makedirs(f"{buildid_dir}/.build-id/{build_id[:2]}", exist_ok=True)
            try:
                os.unlink(f"{buildid_dir}/.build-id/{build_id[:2]}/{build_id[2:]}.debug")
            except FileNotFoundError:
                pass
            os.symlink(
                os.path.relpath(
                    build_id_map[build_id],
                    start=f"{buildid_dir}/.build-id/{build_id[:2]}"
                ),
                f"{buildid_dir}/.build-id/{build_id[:2]}/{build_id[2:]}.debug"
            )
        cmd = [
            *common_llvm_cov_show_opts,
            "--debug-file-directory",
            buildid_dir,
            f"-instr-profile={total_profdata}",
            f"-output-dir=coverage/total/total"
        ]
        run_command(cmd)

        # After the total pass, which is what populates the .build-id symlink
        # farm that per-test export resolves its binaries through.
        if args.per_test:
            logging.info("\n--- Exporting per-test LCOV ---")
            if not profile_manifest:
                logging.warning(
                    f"--per-test: no *.manifest files in {profile_dir}; "
                    "nothing can be attributed to a test name."
                )
            export_per_test_lcov(profile_dir, profile_manifest, buildid_dir)

    logging.info("\n--- Done ---")

if __name__ == "__main__":
    main()
