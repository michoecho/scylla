#!/usr/bin/env python3

import argparse
import glob
import logging
import os
import re
import subprocess
from pathlib import Path

def get_build_id(file_path):
    """Extracts the build-id from an ELF file using readelf."""
    try:
        # The -n option displays notes, which includes the build-id.
        result = subprocess.run(
            ["readelf", "-n", file_path],
            capture_output=True,
            text=True,
            check=True,
            errors='ignore', # Ignore non-UTF8 characters in readelf output
        )
        # The build-id is usually on a line like "    Build ID: aabbcc..."
        match = re.search(r"Build ID:\s*([0-9a-fA-F]+)", result.stdout)
        if match:
            return match.group(1)
    except (subprocess.CalledProcessError, FileNotFoundError):
        # Ignore errors for non-ELF files or if readelf is not found.
        pass
    return None

buildid_regex = re.compile(r"[0-9a-fA-F]+")

def get_profdata_build_ids(profdata_file):
    """Extracts all binary build-ids from a .profdata file."""
    try:
        result = subprocess.run(
            ["llvm-profdata", "show", "--binary-ids", profdata_file],
            capture_output=True,
            text=True,
            check=True,
        )
        # The output is a list of build-ids, one per line.
        lines = [l.strip() for l in result.stdout.strip().split("\n") if l.strip()]
        return [line for line in lines if buildid_regex.fullmatch(line)]
    except (subprocess.CalledProcessError, FileNotFoundError) as e:
        logging.warning(f"Failed to read build-ids from {profdata_file}: {e}")
        return []

def run_command(cmd):
    """Logs and runs a command, checking for errors."""
    logging.info(" ".join(map(str, cmd)))
    subprocess.run(cmd, check=True)

def main():
    """Main function to parse arguments and run coverage merging."""
    parser = argparse.ArgumentParser(
        description="Merge LLVM coverage data and generate reports."
    )
    parser.add_argument(
        "target_dir",
        nargs="?",
        default=".",
        help="Target directory to process (positional)."
    )
    parser.add_argument(
        "-v", "--verbose", action="store_true", help="Enable verbose logging."
    )
    args = parser.parse_args()

    # Configure logging
    log_level = logging.DEBUG if args.verbose else logging.INFO
    logging.basicConfig(
        level=log_level, format="%(levelname)s: %(message)s", datefmt="%H:%M:%S"
    )

    # Immediately change working directory to the target directory.
    try:
        os.chdir(args.target_dir)
        logging.debug(f"Changed working directory to: {args.target_dir}")
    except OSError as e:
        logging.error(f"Could not change directory to {args.target_dir}: {e}")
        raise SystemExit(1)

    # 1. Find all executable ELF files and map their build-ids to paths.
    logging.info("--- Finding executables and build-ids ---")
    build_id_map = {}
    # Search for any file in the current directory and subdirectories.
    for path_str in glob.glob("**/*", recursive=True):
        path = Path(path_str)
        # Check if it's a file and has execute permissions.
        if path.is_file() and not path.is_symlink() and os.access(path, os.X_OK):
            build_id = get_build_id(path)
            if build_id:
                build_id_map[build_id] = path
                logging.debug(f"Found ELF: {path} (Build ID: {build_id})")

    # Find and group all .profraw files.
    profraws = glob.glob("**/*.profraw", recursive=True)
    pattern = r"(.*)\.[^.]*.profraw"
    expr = re.compile(pattern)
    groups = {}
    for p in profraws:
        x = expr.fullmatch(p)
        if x:
            base = x.group(1)
            groups.setdefault(base, []).append(p)
    logging.info(f"Found files:\n{"\n".join(profraws)}")

    common_llvm_cov_show_opts = [
        "llvm-cov",
        "show",
        "-format=html",
        "--show-branches=count",
        "--show-regions",
        "--show-line-counts-or-regions",
    ]

    # 2. Generate coverage reports for each test executable group.
    logging.info("\n--- Generating per-test coverage reports ---")
    for base, ps in groups.items():
        profdata_file = f"{base}.profdata"
        # Merge profraw files for the current group.
        cmd = ["llvm-profdata", "merge", "-sparse", "-o", profdata_file] + ps
        run_command(cmd)

        # Get build-ids of all binaries involved in this test run.
        binary_build_ids = get_profdata_build_ids(profdata_file)
        for build_id in binary_build_ids:
            if build_id in build_id_map:
                binary_path = build_id_map[build_id]
                # Sanitize binary name for use in directory path.
                binary_name_sanitized = Path(binary_path.name).stem
                output_dir = f"coverage/{Path(base).name}/{binary_name_sanitized}"
                # Generate coverage for this specific binary.
                cmd = [
                    *common_llvm_cov_show_opts,
                    str(binary_path),
                    f"-instr-profile={profdata_file}",
                    f"-output-dir={output_dir}"
                ]
                run_command(cmd)
            else:
                logging.warning(f"Could not find binary for build-id {build_id}")

    # 3. Merge all raw profiles and generate total coverage for each ELF.
    if profraws:
        logging.info("\n--- Generating total coverage report ---")
        total_profdata = "total.profdata"
        cmd = ["llvm-profdata", "merge", "-sparse", "-o", total_profdata] + profraws
        run_command(cmd)

        # Get build-ids of all binaries involved in the entire suite.
        total_build_ids = get_profdata_build_ids(total_profdata)
        binary_paths = []
        for build_id in total_build_ids:
            if build_id in build_id_map:
                binary_path = build_id_map[build_id]
                binary_paths.append(binary_path)
                binary_name_sanitized = Path(binary_path.name).stem
                output_dir = f"coverage/total/{binary_name_sanitized}"
                # Generate total coverage for this binary.
                cmd = [
                    *common_llvm_cov_show_opts,
                    str(binary_path),
                    f"-instr-profile={total_profdata}",
                    f"-output-dir={output_dir}"
                ]
                run_command(cmd)
            else:
                logging.warning(f"Could not find binary for build-id {build_id}")
        buildid_dir = "coverage"
        os.makedirs(buildid_dir, exist_ok=True)
        for build_id in total_build_ids:
            os.makedirs(f"{buildid_dir}/.build-id/{build_id[:2]}", exist_ok=True)
            try:
                os.unlink(f"{buildid_dir}/.build-id/{build_id[:2]}/{build_id[2:]}.debug")
            except FileNotFoundError:
                pass
            os.symlink(
                os.path.relpath(
                    build_id_map[build_id],
                    start=f"{buildid_dir}/.build-id/{build_id[:2]}"
                ),
                f"{buildid_dir}/.build-id/{build_id[:2]}/{build_id[2:]}.debug"
            )
        cmd = [
            *common_llvm_cov_show_opts,
            "--debug-file-directory",
            buildid_dir,
            f"-instr-profile={total_profdata}",
            f"-output-dir=coverage/total/total"
        ]
        run_command(cmd)


    logging.info("\n--- Done ---")

if __name__ == "__main__":
    main()
