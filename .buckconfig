[cells]
  root = .
  fuzztest = third-party/fuzztest
  imgui = third-party/imgui
  scylladb = third-party/scylladb
  implot = third-party/implot
  rust_third_party = third-party/rust
  prelude = prelude
  toolchains = buck/toolchains
  none = none

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  fbcode_macros = none
  buck = none

# Uses a copy of the prelude bundled with the buck2 binary. You can alternatively delete this
# section and vendor a copy of the prelude to the `prelude` directory of your project.
[external_cells]
  prelude = bundled

[buck2_re_client]
  action_cache_address = grpc://127.0.0.1:50051
  engine_address = grpc://127.0.0.1:50051
  cas_address = grpc://127.0.0.1:50051
  tls = false
  instance_name = main

[parser]
  target_platform_detector_spec = target:root//...->prelude//platforms:default \
    target:prelude//...->prelude//platforms:default \
    target:fuzztest//...->prelude//platforms:default \
    target:imgui//...->prelude//platforms:default \
    target:implot//...->prelude//platforms:default \
    target:toolchains//...->prelude//platforms:default

[build]
  execution_platforms = root//buck/platforms:platforms

[project]
  # Nested buck-out directories contain materialized external cells, whose BUCK files
  # would otherwise be picked up by target patterns such as `//...`.
  ignore = **/.git, **/buck-out, ignored, .local, .worktrees, third-party/scylladb

# Once the fork is pushed, swap the local clone for a buck2-managed checkout by
# uncommenting the two sections below. Target labels do not change -- that is the
# point of making it a cell now -- but `third-party/fuzztest` stops being a
# working tree, so do it only when you no longer need to commit to the fork
# locally. Delete the directory first; buck2 will not materialise a cell over an
# existing one.
#
# [external_cells]
#   fuzztest = git
#
# [external_cell_fuzztest]
#   git_origin = https://github.com/<you>/fuzztest.git
#   commit_hash = <sha of your buck2 branch>
