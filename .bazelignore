# Directories Bazel must not descend into when expanding `//...`.
#
# Each of these contains BUILD files that are not part of this build: they are
# either another Bazel workspace entirely, or a vendored tree with its own.
# Without this, `bazel test //...` fails while loading them -- their labels
# resolve against packages that do not exist here.

# A standalone Bazel + Nix experiment with its own MODULE.bazel. Gitignored, and
# not part of this workspace.
nuke

# The forked VS Code CMake Tools extension, vendored and gitignored.
tools/vscode-cmake-tools

# Build outputs and caches, none of which contain sources to build.
out
.bazel
.direnv
.cache
ignored
