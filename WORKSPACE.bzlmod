# Bzlmod is the dependency model here -- MODULE.bazel is where dependencies are
# declared, and this file exists only because one thing has no module extension
# yet.
#
# nixpkgs_cc_configure is still a WORKSPACE-style macro in rules_nixpkgs 0.13.0
# (upstream tracks this as "TODO Use module extension once available"). Under
# bzlmod the WORKSPACE file proper is ignored, and WORKSPACE.bzlmod is the
# supported place for the remainder. When the extension lands this file goes
# away and the call moves into MODULE.bazel.

load("@rules_nixpkgs_cc//:cc.bzl", "nixpkgs_cc_configure")

# The C++ toolchain, from Nix rather than from whatever cc happens to be on
# PATH. This is the part of the build Bazel is least hermetic about by default:
# without it Bazel autoconfigures @local_config_cc from the ambient environment,
# so the compiler silently follows the host.
#
# llvmPackages_22.clang matches what the CMake build's devShell uses, so the two
# builds compile with the same compiler rather than merely with "a clang".
#
# cc_std is passed here rather than as a --cxxopt because it lands in the
# toolchain's own CXX_FLAG, so it applies to every action including the ones
# Bazel generates itself, and cannot be lost by a target that overrides copts.
nixpkgs_cc_configure(
    name = "nixpkgs_config_cc",
    cc_std = "c++23",
    nix_file = "//nix/bazel:cc-toolchain.nix",
    nix_file_deps = ["//:flake.lock"],
    repository = "@nixpkgs",
)
