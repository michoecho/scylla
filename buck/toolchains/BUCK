load("@nix//:flake.bzl", "flake")
load("//:cxx.bzl", "nix_cxx_toolchain")
load("@nix//toolchains:python.bzl", "nix_python_bootstrap_toolchain")
load("@prelude//toolchains:genrule.bzl", "system_genrule_toolchain")

# Needed so the flake.package targets stay valid under
# `buck2 build --target-platforms ...`; without it they are compatible with
# nothing and configuration fails before any of them is built.
_TARGET_MAPPING = [
    select({k: k for k in [
        "config//os:linux",
        "config//os:macos",
    ]}),
    select({k: k for k in [
        "config//cpu:arm64",
        "config//cpu:x86_64",
    ]}),
]

# Builds `packages.<system>.cxx` from toolchains/nix/flake.nix and exposes each
# listed binary as a sub-target, which is exactly the shape nix_cxx_toolchain
# reads (it looks up nix_cc["cc"], nix_cc["ar"], and so on).
flake.package(
    name = "nix_cc",
    binaries = [
        "ar",
        "cc",
        "c++",
        "nm",
        "objcopy",
        "ranlib",
        "strip",
    ],
    package = "cxx",
    path = "//nix:flake",
    target_compatible_with = _TARGET_MAPPING,
)

flake.package(
    name = "python",
    binary = "python3",
    package = "python3",
    path = "//nix:flake",
    target_compatible_with = _TARGET_MAPPING,
)

system_genrule_toolchain(
    name = "genrule",
    visibility = ["PUBLIC"],
)

# Required by prelude//cxx/tools:internal_tools, which the cxx toolchain pulls
# in; the example itself contains no Python.
nix_python_bootstrap_toolchain(
    name = "python_bootstrap",
    python = ":python",
    visibility = ["PUBLIC"],
)

nix_cxx_toolchain(
    name = "cxx",
    cxx_flags = ["-std=c++20", "-Wall", "-Wextra"],
    nix_cc = ":nix_cc",
    # Static, so the produced binary does not carry an RPATH into a buck-out
    # symlink that the deferred materializer may not have populated.
    link_style = "static",
    visibility = ["PUBLIC"],
)
