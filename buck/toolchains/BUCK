# use the `cxx` flake package output from `./nix` to provide the compiler tools
flake.package(
    name = "nix_cc",
    binaries = [
        "ar",
        "cc",
        "c++",
        "nm",
        "objcopy",
        "objdump",
        "ranlib",
        "strip",
    ],
    package = "cxx",
    path = "root//:flake",
)

# provide the `cxx` toolchain using the `:nix_cc` target
nix_cxx_toolchain(
    name = "cxx",
    nix_cc = ":nix_cc",
    cxx_flags = [
        "-std=c++23",
        "-Wall",
        "-Wextra",
        "-fno-omit-frame-pointer",
        # Project-wide rather than per-target, because a precompiled header has
        # to have been built under the same thread model as every translation
        # unit that includes it -- clang rejects the mismatch outright ("POSIX
        # thread support was disabled in precompiled file ... but is currently
        # enabled"). Libraries that arrive through pkg-config bring `-pthread`
        # with them (abseil and re2 do), so any dependency on one would
        # otherwise be a build error for the whole module rather than for the
        # file that uses it.
        "-pthread",
    ] + select({
        "root//:build_mode[debug]": [
            "-O0",
            "-g",
        ],
        "root//:build_mode[release]": ["-O3"],
    }) + select({
        "root//:libafl": [
            "-fsanitize-coverage=trace-pc-guard,trace-cmp",
            "-fno-sanitize-link-runtime",
        ],
        "root//:coverage": [
            "-fprofile-instr-generate",
            "-fcoverage-mapping",
        ],
        # FuzzTest's fuzzing mode, mirroring upstream's
        # cmake/FuzzTestFlagSetup.cmake. The coverage instrumentation is what
        # the in-process engine steers on: `inline-8bit-counters` gives it edge
        # coverage, `trace-cmp` the comparison operands it uses to solve
        # branches. ASan is what turns a mutated input into a detectable
        # failure rather than silent corruption, and `-UNDEBUG` keeps assertions
        # live so they can fail too.
        #
        # FuzzTest's own sources opt back out with `-fsanitize-coverage=0`; see
        # FUZZTEST_COPTS in third-party/fuzztest/BUCK.
        "root//:fuzztest": [
            "-g",
            "-UNDEBUG",
            "-DFUZZING_BUILD_MODE_UNSAFE_FOR_PRODUCTION",
            "-DADDRESS_SANITIZER",
            "-fsanitize=address",
            "-DNDEBUG_SANITIZER",
            "-fsanitize-coverage=inline-8bit-counters",
            "-fsanitize-coverage=trace-cmp",
        ],
        "root//:centipede": [
            "-g",
            "-UNDEBUG",
            "-DFUZZING_BUILD_MODE_UNSAFE_FOR_PRODUCTION",
            "-DADDRESS_SANITIZER",
            "-fsanitize=address",
            # Abseil's Swiss tables add a generation counter to every iterator
            # when built under ASan, changing the layout of the iterator. The
            # nixpkgs Abseil is not built under ASan, so without this its
            # out-of-line code hands back the disabled variant's null
            # generation pointer and the header-inline code dereferences it --
            # an immediate SEGV inside flat_hash_set::begin(). `NDEBUG_SANITIZER`
            # is Abseil's own opt-out ("If defined, performance is important"),
            # which puts our translation units back in agreement with the
            # library. The alternative is a second Abseil built with matching
            # ASan flags; this is cheaper and faster to fuzz under.
            "-DNDEBUG_SANITIZER",
            "-fsanitize-coverage=inline-8bit-counters",
            "-fsanitize-coverage=trace-cmp",
        ],
        "DEFAULT": [],
    }),
    link_flags = select({
        "root//:coverage": [
            "-fprofile-instr-generate",
            "-fcoverage-mapping",
            "-Wl,--build-id",
        ],
        "root//:fuzztest": ["-fsanitize=address"],
        "root//:centipede": ["-fsanitize=address"],
        "DEFAULT": [],
    }),
    visibility = ["PUBLIC"],
)

