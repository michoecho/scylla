nix_rust_toolchain(
    name = "rust",
    clippy = ":clippy",
    default_edition = "2024",
    rustc = ":rustc",
    rustdoc = ":rustc[rustdoc]",
    visibility = ["PUBLIC"],
)

# bindgen's runtime dependencies, for build scripts under third-party/rust that
# run it. bindgen dlopen()s libclang rather than linking it, so what it wants is
# a directory (LIBCLANG_PATH); and it invokes clang directly rather than through
# the cxx toolchain, so the kernel UAPI headers have to be handed to it as an
# explicit -isystem. See third-party/rust/fixups/perf2perfetto/fixups.toml.
flake.package(
    name = "libclang",
    files = {
        "lib": "lib",
        # The library itself, for something that links it rather than dlopen()ing
        # it: the trace viewer reads a decoder header with libclang at startup.
        # See root//:libclang.
        "libclang": "lib/libclang.so",
    },
    # Multi-output derivation; libclang.so lives in `lib`, not the default `out`.
    output = "lib",
    path = "root//:flake",
    visibility = ["PUBLIC"],
)

# clang-c/Index.h and friends, which are in the `dev` output rather than beside
# the library. Only something that *links* libclang wants these; bindgen loads it
# by path and needs none of them.
flake.package(
    name = "libclang_headers",
    files = {"include": "include"},
    output = "dev",
    package = "libclang",
    path = "root//:flake",
    visibility = ["PUBLIC"],
)

flake.package(
    name = "linux_headers",
    files = {"include": "include"},
    package = "linux-headers",
    path = "root//:flake",
    visibility = ["PUBLIC"],
)
