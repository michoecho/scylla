load("@nix//flake.bzl", "flake")

# zstd from the pinned nixpkgs, in two pieces because Nix splits it that way:
# `dev` carries include/zstd.h, the default output carries lib/libzstd.so.
# Each flake.package target builds one output; prebuilt_cxx_library below is
# what presents them to the C++ rules as a single library.
flake.package(
    name = "zstd_dev",
    package = "zstd",
    output = "dev",
    path = "toolchains//nix:flake",
)

flake.package(
    name = "zstd_lib",
    package = "zstd",
    output = "out",
    path = "toolchains//nix:flake",
)

# The store paths are only known once the two targets above have run, so the
# header directory and the .so are pulled out with genrules rather than named
# literally. Copying (rather than symlinking) matters: buck2 hashes these
# artifacts into the action's cache key, and a symlink into /nix/store would
# hash as a dangling link.
genrule(
    name = "zstd_headers",
    out = "include",
    cmd = "cp -rL $(location :zstd_dev)/include $OUT",
)

# The real shared object, resolved through the `libzstd.so` symlink to the
# versioned file it points at. `cp -L` is what makes this a regular file rather
# than a symlink into /nix/store, so the artifact buck2 hashes is the library
# itself and the cache key covers its contents.
genrule(
    name = "zstd_shared_lib",
    out = "libzstd.so.1",
    cmd = "cp -L $(location :zstd_lib)/lib/libzstd.so.1 $OUT",
)

# `soname` is the attribute that makes dynamic linking work here. The ELF
# carries SONAME=libzstd.so.1, so that -- not the artifact's filename -- is what
# the loader searches for at startup. Declaring it lets the prelude name the
# library correctly in the link and register it as a shared library the binary
# depends on, which is what gets it into the runtime symlink tree that
# `buck2 run` and `buck2 install` set up.
#
# `preferred_linkage = "shared"` then keeps it out of the static link even
# though the toolchain's default link_style is static.
prebuilt_cxx_library(
    name = "zstd",
    header_dirs = [":zstd_headers"],
    shared_lib = ":zstd_shared_lib",
    soname = "libzstd.so.1",
    preferred_linkage = "shared",
    visibility = ["PUBLIC"],
)
