/.cache
/.direnv
/.envrc
/.local
/out
/compile_commands.json
/.vscode
/ignored
/.claude/settings.local.json

# Nix build result symlink (e.g. from `nix build .#code`)
/result

# AFL++ scratch: seed corpora and fuzzer output (queue, crashes, stats). Fuzz
# runs are ad-hoc and their corpora are throwaway, so the whole directory is
# ignored; the fuzz targets themselves live in src/.
/fuzz

# Intel PT capture artifacts from tools/pt-trace: the raw perf.data and the
# .ftf it decodes into. Both are regenerated by re-running the trace and a
# single .ftf runs to megabytes, so neither belongs in history. Not anchored
# to the root -- pt-trace writes wherever -o/--ftf point.
perf.data
perf.data.old
*.perf.data
*.ftf
