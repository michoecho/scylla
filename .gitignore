/.cache
/.direnv
/.envrc
/.local
/out
/compile_commands.json
/.vscode/*
!/.vscode/settings.json
/ignored
/.claude/settings.local.json

# Nix build result symlink (e.g. from `nix build .#code`)
/result

# AFL++ scratch: seed corpora and fuzzer output (queue, crashes, stats). Fuzz
# runs are ad-hoc and their corpora are throwaway, so the whole directory is
# ignored; the fuzz targets themselves live in src/.
/fuzz

/tools/vscode-buck2/extension/buck2-test.vsix
/nuke
buck-out/

# The FuzzTest fork is its own git repository (a fork of google/fuzztest carrying
# our Buck2 build), cloned here and wired in as the `fuzztest` buck cell. It is
# pushed and versioned separately, so the parent repo does not track it.
/third-party/fuzztest

# Dear ImGui and ImPlot are separate upstream repositories, with their small
# Buck2 integration commits kept in the nested clones and wired as cells.
/third-party/imgui
/third-party/implot
/third-party/scylla
/references

# Lock file written by snapshot update runs; not a snapshot.
.update.lock
