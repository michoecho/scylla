load("//buck:module.bzl", "add_module")

# The header is the whole implementation, so it gets a target of its own. The
# plugins below need it, and the module depends on the plugins -- routing them
# through `:static_keys` instead would be a dependency cycle.

cxx_library(
    name = "static_keys_headers",
    exported_headers = {
        "static_keys/static_keys.h": "include/static_keys/static_keys.h",
    },
    header_namespace = "",
    exported_linker_flags = [
        # Executables need their copy of the jump table registry visible to
        # dlopen()ed libraries, which resolve against the executable's dynamic
        # symbol table. See "Modules" in static_keys.h.
        "-Wl,--export-dynamic",
        # dladdr(), which the header uses to tell whether a key belongs to the
        # object whose table is being registered. A no-op on glibc 2.34 and
        # later, where libdl was folded into libc.
        "-ldl",
    ],
    visibility = ["PUBLIC"],
)

# The declaration of the key the executable owns and the libraries branch on.
cxx_library(
    name = "shared_key_header",
    exported_headers = {
        "static_keys_test/shared_key.h": "plugin/shared_key.h",
    },
    header_namespace = "",
    exported_deps = [":static_keys_headers"],
    visibility = ["PUBLIC"],
)

# Two shared libraries that own static keys, covering the two ways a jump table
# can reach a process: linked at build time, and dlopen()ed later.
#
# Both are `preferred_linkage = "shared"` so they stay real DSOs with their own
# __jump_table sections. Linked statically into the test they would merge into
# the executable's table and prove nothing.

cxx_library(
    name = "linked_plugin",
    srcs = ["plugin/linked_plugin.cc"],
    exported_deps = [":shared_key_header"],
    preferred_linkage = "shared",
    header_namespace = "",
    visibility = ["PUBLIC"],
)

cxx_library(
    name = "dlopen_plugin",
    srcs = ["plugin/dlopen_plugin.cc"],
    exported_deps = [":shared_key_header"],
    preferred_linkage = "shared",
    header_namespace = "",
    visibility = ["PUBLIC"],
)

add_module(
    name = "static_keys",
    srcs = [
        "static_keys_test.cc",
        "shared_lib_test.cc",
    ],
    exported_headers = {
        "static_keys/static_keys.h": "include/static_keys/static_keys.h",
    },
    deps = [
        "//:doctest",
        ":linked_plugin",
        ":shared_key_header",
    ],
    # The dlopen()ed plugin is never linked, so it has to travel to the test as
    # data and be found by path at runtime.
    resources = [":dlopen_plugin"],
    env = {
        "STATIC_KEYS_DLOPEN_PLUGIN": "$(location :dlopen_plugin)",
    },
    module_source_dir = "modules/static_keys",
)

# The listing test, in a binary of its own -- which is a correctness
# requirement, not tidiness.
#
# list_static_keys() answers a question about the *process*: every key in every
# loaded object. In a shared executable that answer includes the keys of every
# other test file linked beside it, so adding a key to a branch test, or to one
# of its plugin fixtures, would break a snapshot that has nothing to do with it.
# Kept apart, the listing describes exactly the two files below, and a diff in
# it is a diff in what those two say.

cxx_library(
    name = "list_plugin",
    srcs = ["plugin/list_plugin.cc"],
    exported_deps = [":static_keys_headers"],
    preferred_linkage = "shared",
    header_namespace = "",
    visibility = ["PUBLIC"],
)

add_module(
    name = "static_key_list",
    srcs = ["static_key_list_test.cc"],
    deps = [
        "//:doctest",
        "//modules/snapshot:snapshot",
        ":list_plugin",
        ":static_keys_headers",
    ],
    module_source_dir = "modules/static_keys",
)
