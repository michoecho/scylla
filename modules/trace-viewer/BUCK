load("//buck:module.bzl", "add_module")

# Latency trace viewer.  The UI sources are source-backed external cells so
# updating them does not require a nixpkgs package for either library.

# The wire format, as a header and nothing else. Two things include it: the
# decoder plugin the viewer compiles at startup, which is this file plus a
# switch over tracepoint ids, and anything that wants to read a trace's bytes
# without knowing what any particular record means -- modules/tracer's tests,
# which write records with the tracer and read them back with this.
#
# It is the only description of the format now. There used to be a second, in a
# decoder header the tracer generated; the two agreed by inspection, which is
# not a thing that stays true.
cxx_library(
    name = "trace_wire",
    exported_headers = {"trace_wire.h": "trace_wire.h"},
    header_namespace = "",
    preferred_linkage = "static",
    visibility = ["PUBLIC"],
)

# Turning an ELF object into the list of tracepoints it was built with, which is
# the other half of what a decode needs. Separate from the module below so that
# a reader of traces can have it without the generator, the compiler and the
# dlopen that come with a plugin.
cxx_library(
    name = "tracepoint_table",
    srcs = ["tracepoint_table.cc"],
    exported_headers = {"tracepoint_table.h": "tracepoint_table.h"},
    header_namespace = "",
    exported_deps = [
        ":trace_wire",
        "//:fmt",
    ],
    preferred_linkage = "static",
    visibility = ["PUBLIC"],
)

# The three headers a decoder plugin is compiled against, as text, for the
# viewer to write back out when it compiles one at startup.
#
# Compiled in rather than read from beside the binary: the plugin has to be
# built against the very events.h this viewer was built from, and a path would
# only be a promise that the source tree is still the one the binary came from.
# The raw-string delimiter keeps the headers' own quotes and backslashes out of
# it; it is short because clang refuses one longer than sixteen characters.
genrule(
    name = "embedded_sources",
    srcs = [
        "events.h",
        "plugin_abi.h",
        "trace_wire.h",
    ],
    out = "embedded_sources.inc",
    cmd = """
    {
      echo '// Generated from events.h, plugin_abi.h and trace_wire.h. Do not edit.'
      echo '#pragma once'
      echo 'namespace embedded {'
      echo 'inline constexpr char events_h[] = R"TRACEVIEWER('
      cat $SRCDIR/events.h
      echo ')TRACEVIEWER";'
      echo 'inline constexpr char plugin_abi_h[] = R"TRACEVIEWER('
      cat $SRCDIR/plugin_abi.h
      echo ')TRACEVIEWER";'
      echo 'inline constexpr char trace_wire_h[] = R"TRACEVIEWER('
      cat $SRCDIR/trace_wire.h
      echo ')TRACEVIEWER";'
      echo '}  // namespace embedded'
    } > $OUT
    """,
)

cxx_library(
    name = "embedded_sources_header",
    exported_headers = {
        "embedded_sources.inc": ":embedded_sources",
    },
    header_namespace = "",
    preferred_linkage = "static",
)

# The decoding half of the viewer: the tables in, the generated plugin out. It
# is a module rather than two sources of the binary because it is the part with
# tests -- the plan and the source it writes are ordinary values, and a table
# that is a table nothing can be built from is easier to hand it than to build.
#
# The test binary is //modules/trace-viewer:decoder_plugin_test; the viewer
# itself links the library, test cases and all, which costs a few registrations
# it never runs.
add_module(
    name = "decoder_plugin",
    srcs = [
        "decoder_plugin.cc",
        "decoder_plugin_test.cc",
    ],
    exported_headers = {
        "decoder_plugin.h": "decoder_plugin.h",
        "events.h": "events.h",
        "plugin_abi.h": "plugin_abi.h",
    },
    deps = [
        ":embedded_sources_header",
        ":tracepoint_table",
        ":trace_wire",
        "//:doctest",
        "//:fmt",
    ],
    # dlopen(), which is how a compiled plugin is reached. Exported so that the
    # module's own test binary links as well as the viewer does.
    exported_linker_flags = ["-ldl"],
    # The demo's objects, so that the ELF side of this has something real to be
    # read against: two objects, one of them a shared library, with a tracepoint
    # written in a header compiled into both.
    resources = {
        "dsos": "//modules/tracer:dso_dir",
    },
    env = {
        "TRACER_DSOS": "$(location //modules/tracer:dso_dir)",
    },
    module_source_dir = "modules/trace-viewer",
)

# The viewer: the same trace, read into a catalogue of tables and a sequence of
# passes over them. See the header comment in viewer.cc.
#
# -rdynamic because a decoder plugin calls back into this binary by name: the
# `on_decode_*` symbols beside decode_sink have to be in .dynsym for dlopen() to
# bind them. -ldl for the dlopen itself.
cxx_binary(
    name = "viewer",
    srcs = ["viewer.cc"],
    headers = [
        "events.h",
        "plugin_abi.h",
    ],
    header_namespace = "",
    link_style = "static",
    linker_flags = [
        "-rdynamic",
        "-ldl",
    ],
    deps = [
        ":decoder_plugin",
        "//:doctest_impl",
        "//:fmt",
        "//:opengl",
        "//:sdl3",
        "imgui//:imgui",
        "imgui//:imgui_sdl3_opengl3",
        "implot//:implot",
    ],
)
