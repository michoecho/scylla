prebuilt_cxx_library(
    name = "libafl_c",
    header_dirs = ["include"],
    shared_lib = "//modules/libafl/rust:libafl-wrapper[cdylib]",
    soname = "liblibafl_c.so",
    # The Rust buildscript runner forwards lib/search flags but drops
    # rustc-link-arg, and Rust hides native archive symbols in a cdylib. Link
    # LibAFL's SanCov archives at the final C++ boundary so the callbacks are
    # globally visible to all instrumented C++ objects.
    exported_linker_flags = [
        "-Wl,--whole-archive",
        "$(location rust_third_party//:libafl_targets-build-script-run-public[out_dir])/libsancov_cmp.a",
        "$(location rust_third_party//:libafl_targets-build-script-run-public[out_dir])/libcommon.a",
        "$(location rust_third_party//:libafl_targets-build-script-run-public[out_dir])/libcoverage.a",
        "$(location rust_third_party//:libafl_targets-build-script-run-public[out_dir])/libcmplog.a",
        "-Wl,--no-whole-archive",
    ],
    preferred_linkage = "shared",
    visibility = ["PUBLIC"],
)
