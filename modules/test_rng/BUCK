    srcs = [
        "test_rng.cc",
        "backend_demo_test.cc",
    ],
    exported_headers = {
        "test_rng/test_rng.h": "include/test_rng/test_rng.h",
    },
    deps = [
        "//modules/exhaustigen:exhaustigen",
        "//modules/libafl:libafl_c",
        "//:hegel",
    ],
    compiler_flags = [
        "-std=c++23",
        "-Wall",
        "-Wextra",
        "-DBUILD_LIBAFL",
    ] + select({
        "//:libafl": [
            "-O0",
            "-g",
            "-fsanitize-coverage=trace-pc-guard",
            "-fno-sanitize-link-runtime",
        ],
        "DEFAULT": [],
    }),
    exported_linker_flags = select({
        "//:libafl": ["-fno-sanitize-link-runtime"],
        "DEFAULT": [],
    }),
    module_source_dir = "modules/test_rng",
)
