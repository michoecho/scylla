load("//buck:module.bzl", "add_module")

filegroup(
    name = "snapshots",
    srcs = glob([".snapshots/**"]),
    visibility = ["PUBLIC"],
)

add_module(
    name = "exhaustigen",
    srcs = [
        "exhaustigen_test.cc",
        "hegel_splits_test.cc",
    ],
    exported_headers = {
        "exhaustigen/exhaustigen.h": "include/exhaustigen/exhaustigen.h",
    },
    deps = [
        "//modules/snapshot:snapshot",
        "//:hegel",
    ],
    compiler_flags = [
        "-std=c++23",
        "-Wall",
        "-Wextra",
    ],
    env = {
        "SNAPSHOT_ROOT": "$(location :snapshots)/.snapshots",
    },
    module_source_dir = "modules/exhaustigen",
)
