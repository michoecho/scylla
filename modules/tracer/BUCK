load("//buck:module.bzl", "add_module")

# The library, without the module's test sources.
#
# add_module() puts test translation units *into* the module library and links
# it whole, which is what makes doctest registration work -- but it also means
# anything depending on :tracer drags those TUs in. A tracepoint is a static in
# an ELF section, so test tracepoints linked into :trace_producer would land in
# the very table the code generator walks. Splitting the production code out
# keeps the producer's tracepoint table equal to its own call sites.
cxx_library(
    name = "tracer_core",
    srcs = [
        "codegen.cc",
        "tracer.cc",
    ],
    exported_headers = {
        "tracer/codegen.h": "include/tracer/codegen.h",
        "tracer/tracer.h": "include/tracer/tracer.h",
    },
    header_namespace = "",
    # Exported: tracer.h expands a static key into every TRACEPOINT(), so the
    # header is unusable without static_keys' own header -- and without the
    # -Wl,--export-dynamic and -ldl that target carries.
    exported_deps = [
        # Exported for the same reason: a TRACEPOINT() may carry a
        # srcloc::location, so the wire type is part of this header's interface.
        "//modules/source_location:source_location_core",
        "//modules/static_keys:static_keys_headers",
    ],
    exported_linker_flags = [
        # A trace names the objects it came from by build ID, which is the only
        # identity that survives the process. Nothing here has one by default.
        "-Wl,--build-id=sha1",
    ],
    preferred_linkage = "static",
    visibility = ["PUBLIC"],
)

# The demo's shared library, and the two headers it shares with the executable.
#
# Its reason to exist is that a trace has to survive coming from more than one
# loaded object: the library has its own `tracepoints` section, its own
# __start/__stop brackets and its own static keys, and its records are only
# decodable because the trace says where its table was mapped.
#
# `preferred_linkage = "shared"` is load-bearing. Linked statically its table
# would merge into the executable's and the whole thing would prove nothing.

cxx_library(
    name = "demo_clock",
    exported_headers = {
        "tracer_demo/demo_clock.h": "plugin/demo_clock.h",
    },
    header_namespace = "",
    visibility = ["PUBLIC"],
)

# A tracepoint written in a header, compiled once into every object that
# includes it. Both the executable and the library below do.
cxx_library(
    name = "common_tracepoints",
    exported_headers = {
        "tracer_demo/common_tracepoints.h": "plugin/common_tracepoints.h",
    },
    header_namespace = "",
    exported_deps = [
        ":demo_clock",
        ":tracer_core",
    ],
    visibility = ["PUBLIC"],
)

cxx_library(
    name = "trace_plugin",
    srcs = ["plugin/trace_plugin.cc"],
    exported_headers = {
        "tracer_demo/trace_plugin.h": "plugin/trace_plugin.h",
    },
    header_namespace = "",
    exported_deps = [":common_tracepoints"],
    preferred_linkage = "shared",
    visibility = ["PUBLIC"],
)

# Step 1: the binary that owns the tracepoints. It can print a decoder for its
# own table, and it can run a workload and dump the resulting trace.
cxx_binary(
    name = "trace_producer",
    srcs = ["trace_producer.cc"],
    header_namespace = "",
    deps = [
        ":trace_plugin",
        ":tracer_core",
    ],
)

# Step 2: generate the decoder's source from that binary's tracepoint table.
# This is where a tracepoint whose name or parameter names cannot become a
# struct becomes a build failure, with a diagnostic naming the call site.
genrule(
    name = "decoder_src",
    out = "decoder.h",
    cmd = "$(exe :trace_producer) --emit-decoder > $OUT",
)

# The generated header, as something to depend on. Both the decoder program and
# the module's own tests are built against it.
cxx_library(
    name = "decoder",
    exported_headers = {
        "tracer_generated/decoder.h": ":decoder_src",
    },
    header_namespace = "",
    preferred_linkage = "static",
    visibility = ["PUBLIC"],
)

# Step 3: separately, run the workload and dump a trace. Independent of step 2
# because a record is decoded through the object header the trace carries, not
# through the addresses this particular run happened to be given -- otherwise
# these two runs of a PIE binary, with a shared library each mapped somewhere
# else again, would disagree.
genrule(
    name = "trace_bin",
    out = "trace.bin",
    cmd = "$(exe :trace_producer) --emit-trace $OUT",
)

# Step 3b: the objects the trace's source locations point into, filed by build
# ID. A location is one address inside a loaded object, so unlike a tracepoint --
# whose name and file are compiled into the decoder -- reading one back needs the
# object file itself. See "handing the objects to a decoder" in tracer.h.
genrule(
    name = "dso_dir",
    out = "dsos",
    cmd = "$(exe :trace_producer) --emit-dsos $OUT",
)

# Step 4: a program that decodes with the generated header. It is a callback
# that prints and nothing else -- and it is the check that the generated header
# compiles standing on its own, outside the test that also includes it.
cxx_binary(
    name = "trace_decoder",
    srcs = ["trace_decoder.cc"],
    header_namespace = "",
    deps = [":decoder"],
)

# Step 5: decode the trace. Its output is what the snapshot test asserts on.
genrule(
    name = "decoded_trace",
    out = "decoded.txt",
    # TRACE_DSO_DIR is where the generated decoder looks for the objects; the
    # decoder program itself says nothing about them.
    cmd = "TRACE_DSO_DIR=$(location :dso_dir) $(exe :trace_decoder) $(location :trace_bin) > $OUT",
)

add_module(
    name = "tracer",
    srcs = ["tracer_test.cc"],
    deps = [
        ":decoder",
        ":tracer_core",
        "//:doctest",
        "//modules/snapshot:snapshot",
    ],
    resources = {
        "decoded.txt": ":decoded_trace",
        # The library is never linked into the test: it is dlopen()ed by the
        # DSO test, which wants to watch the process's view of the tracepoint
        # tables change as it arrives and leaves.
        "trace_plugin": ":trace_plugin",
        "trace.bin": ":trace_bin",
        # The producer's objects, so that the test can resolve the source
        # locations in the trace exactly as :decoded_trace does.
        "dsos": ":dso_dir",
    },
    env = {
        "TRACER_DECODED": "$(location :decoded_trace)",
        "TRACER_DSOS": "$(location :dso_dir)",
        "TRACER_PLUGIN": "$(location :trace_plugin)",
        "TRACER_TRACE": "$(location :trace_bin)",
    },
    module_source_dir = "modules/tracer",
)
