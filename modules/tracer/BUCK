load("//buck:module.bzl", "add_module")

# The library, without the module's test sources.
#
# add_module() puts test translation units *into* the module library and links
# it whole, which is what makes doctest registration work -- but it also means
# anything depending on :tracer drags those TUs in. A tracepoint is a static in
# an ELF section, so test tracepoints linked into :trace_producer would land in
# the very table the code generator walks. Splitting the production code out
# keeps the producer's tracepoint table equal to its own call sites.
cxx_library(
    name = "tracer_core",
    srcs = [
        "codegen.cc",
        "tracer.cc",
    ],
    exported_headers = {
        "tracer/codegen.h": "include/tracer/codegen.h",
        "tracer/tracer.h": "include/tracer/tracer.h",
    },
    header_namespace = "",
    # Exported: tracer.h expands a static key into every TRACEPOINT(), so the
    # header is unusable without static_keys' own header -- and without the
    # -Wl,--export-dynamic and -ldl that target carries.
    exported_deps = ["//modules/static_keys:static_keys_headers"],
    preferred_linkage = "static",
    visibility = ["PUBLIC"],
)

# Step 1: the binary that owns the tracepoints. It can print a decoder for its
# own table, and it can run a workload and dump the resulting trace.
cxx_binary(
    name = "trace_producer",
    srcs = ["trace_producer.cc"],
    header_namespace = "",
    deps = [":tracer_core"],
)

# Step 2: generate the decoder's source from that binary's tracepoint table.
# This is where a tracepoint whose name or parameter names cannot become a
# struct becomes a build failure, with a diagnostic naming the call site.
genrule(
    name = "decoder_src",
    out = "decoder.h",
    cmd = "$(exe :trace_producer) --emit-decoder > $OUT",
)

# The generated header, as something to depend on. Both the decoder program and
# the module's own tests are built against it.
cxx_library(
    name = "decoder",
    exported_headers = {
        "tracer_generated/decoder.h": ":decoder_src",
    },
    header_namespace = "",
    preferred_linkage = "static",
    visibility = ["PUBLIC"],
)

# Step 3: separately, run the workload and dump a trace. Independent of step 2
# only because a record identifies its tracepoint by index rather than by
# address -- otherwise these two runs of a PIE binary would disagree.
genrule(
    name = "trace_bin",
    out = "trace.bin",
    cmd = "$(exe :trace_producer) --emit-trace $OUT",
)

# Step 4: a program that decodes with the generated header. It is a callback
# that prints and nothing else -- and it is the check that the generated header
# compiles standing on its own, outside the test that also includes it.
cxx_binary(
    name = "trace_decoder",
    srcs = ["trace_decoder.cc"],
    header_namespace = "",
    deps = [":decoder"],
)

# Step 5: decode the trace. Its output is what the snapshot test asserts on.
genrule(
    name = "decoded_trace",
    out = "decoded.txt",
    cmd = "$(exe :trace_decoder) $(location :trace_bin) > $OUT",
)

add_module(
    name = "tracer",
    srcs = ["tracer_test.cc"],
    deps = [
        ":decoder",
        ":tracer_core",
        "//:doctest",
        "//modules/snapshot:snapshot",
    ],
    resources = {
        "decoded.txt": ":decoded_trace",
        "trace.bin": ":trace_bin",
    },
    env = {
        "TRACER_DECODED": "$(location :decoded_trace)",
        "TRACER_TRACE": "$(location :trace_bin)",
    },
    module_source_dir = "modules/tracer",
)
