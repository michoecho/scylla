+    /// Returns a basic_stacktrace object containing a stacktrace captured at
+    /// the point where the exception referred to by `e` was thrown by its
+    /// initial throw-expression (i.e. not a rethrow), or an empty
+    /// basic_stacktrace object under the same conditions as
+    /// from_current_exception().
+    ///
+    /// Unlike from_current_exception() this accepts any exception_ptr: the
+    /// exception does not have to be the one currently being handled, and may
+    /// have been thrown on another thread.
+    ///
+    /// NOT PART OF UPSTREAM BOOST. Added by
+    /// nix/patches/boost-stacktrace-from-exception-ptr.patch, and available
+    /// on ELF platforms with GCC-compatible compilers only.
+    static basic_stacktrace<Allocator> from_exception(const std::exception_ptr& e, const allocator_type& alloc = allocator_type()) noexcept {
+        // Matches the constant from implementation
+        constexpr std::size_t kStacktraceDumpSize = 4096;
+
+        const char* trace = nullptr;
+#if defined(__GNUC__) && defined(__ELF__)
+        if (impl::exception_stacktrace) {
+            trace = impl::exception_stacktrace(e);
+        }
+#else
+        (void)e;
+#endif
+
+        if (trace) {
             try {
