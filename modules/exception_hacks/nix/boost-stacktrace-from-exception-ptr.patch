 }
 
+BOOST_SYMBOL_EXPORT const char* current_exception_stacktrace() noexcept {
+  if (!ref_capture_stacktraces_at_throw()) {
+    return nullptr;
+  }
+
+  auto exc_ptr = std::current_exception();
+  return exception_stacktrace(exc_ptr);
+}
