+BOOST_SYMBOL_EXPORT const char* exception_stacktrace(const std::exception_ptr& e) noexcept {
+  // Deliberately does not consult ref_capture_stacktraces_at_throw(): that
+  // flag is thread local, and `e` may name an exception thrown by a thread
+  // other than this one. An exception allocated while capture was disabled
+  // has a null dump pointer in its padding, so it reads back as an empty
+  // trace either way.
+  void* const exc_raw_ptr = get_current_exception_raw_ptr(
+    const_cast<std::exception_ptr*>(&e)
+  );
   if (!exc_raw_ptr) {
     return nullptr;
   }
@@ -353,6 +355,15 @@
