# The Bazel build, which runs in parallel with the CMake one. Neither is
# generated from the other; they are two independent descriptions of the same
# sources, and only a subset of the tree is ported so far (see BUILD.bazel
# files under modules/).
module(
    name = "cpp_template",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.0.17")
bazel_dep(name = "platforms", version = "0.0.10")

# Not used by anything in this project directly. It is a dependency of
# nixpkgs_cc_configure, which is called from WORKSPACE.bzlmod -- and repository
# rules invoked from there resolve labels against the *root* module's
# dependencies, not against those of the module that defined them. So it has to
# be declared here or the load() inside rules_nixpkgs_cc fails with a repository
# cycle. It goes away when the cc toolchain gets a module extension and that
# call moves into this file.
bazel_dep(name = "bazel_skylib", version = "1.7.1")

# --- Nix-provided dependencies ----------------------------------------------
#
# Every C++ dependency and the C++ toolchain itself come from Nix, not from the
# Bazel registry. See //third_party:BUILD.bazel for why no ordinary target ever
# names one of these @nixpkgs_* repositories directly.
bazel_dep(name = "rules_nixpkgs_core", version = "0.13.0")

# rules_nixpkgs' CC toolchain scripts start with `#!/bin/bash`, which does not
# exist on NixOS -- so the ruleset whose entire purpose is to marry Bazel to Nix
# does not work out of the box on a Nix machine. The only interpreters at a
# fixed path there are /bin/sh and /usr/bin/env.
#
# The failure is worth recognising because the message misdirects: execvp
# reports ENOENT and Bazel surfaces "No such file or directory" naming the
# *script*, which is present and executable. It is the interpreter that is
# missing.
#
# generate_system_module_map.sh fails first; the two cc_wrapper templates
# become the compiler driver the toolchain invokes, so they would fail the same
# way at the first link action.
#
# patch_cmds rather than a patch file: Bazel's built-in patch implementation
# rejected the equivalent diff (CONTENT_DOES_NOT_MATCH_TARGET) even though GNU
# patch applies it cleanly to the identical bytes. It is a reimplementation
# rather than a port, and it is fussy about repeated context lines -- of which
# a shebang fix in a licence-header comment block has several. A sed over a
# one-line change is both more robust and easier to read than the diff was.
#
# archive_override rather than single_version_override: the latter accepts
# patch_cmds but they are silently not applied to a module resolved from the
# registry (observed on Bazel 7.6.0 -- the commands never run, the shebang stays
# /bin/bash, and nothing is reported). Overriding to the same upstream tarball
# the registry itself points at goes through http_archive, where patch_cmds does
# work. Same bytes, same version; only the fetch path differs.
archive_override(
    module_name = "rules_nixpkgs_core",
    integrity = "sha256-MCcfe9OA5OIOTXEywySUbE/bwx6+C7tmOKD2GjfnQ5c=",
    patch_cmds = [
        "sed -i '1s|^#!/bin/bash$|#!/usr/bin/env bash|' " +
        "private/cc_toolchain/generate_system_module_map.sh " +
        "private/cc_toolchain/linux_cc_wrapper.sh.tpl " +
        "private/cc_toolchain/osx_cc_wrapper.sh.tpl",
    ],
    strip_prefix = "rules_nixpkgs-0.13.0/core",
    urls = ["https://github.com/tweag/rules_nixpkgs/releases/download/v0.13.0/rules_nixpkgs-0.13.0.tar.gz"],
)

# rules_nixpkgs_cc is not published to the Bazel Central Registry (only
# rules_nixpkgs_core is), so it is pulled from the upstream release tarball
# with the toolchains/cc subdirectory stripped out of it. Same version as the
# core module above; they are released together and expect to match.
bazel_dep(name = "rules_nixpkgs_cc", version = "0.13.0")
archive_override(
    module_name = "rules_nixpkgs_cc",
    integrity = "sha256-MCcfe9OA5OIOTXEywySUbE/bwx6+C7tmOKD2GjfnQ5c=",
    strip_prefix = "rules_nixpkgs-0.13.0/toolchains/cc",
    urls = ["https://github.com/tweag/rules_nixpkgs/releases/download/v0.13.0/rules_nixpkgs-0.13.0.tar.gz"],
)

# The nixpkgs every nix_pkg tag below resolves against. It is a plain .nix file
# rather than a flake reference because rules_nixpkgs evaluates it with
# nix-build, outside flake evaluation -- but that file reads the revision out
# of this project's flake.lock, so the devShell and Bazel share one pin. See
# the comments in //nix/bazel:nixpkgs.nix.
nix_repo = use_extension("@rules_nixpkgs_core//extensions:repository.bzl", "nix_repo")
nix_repo.file(
    name = "nixpkgs",
    file = "//nix/bazel:nixpkgs.nix",
    file_deps = ["//:flake.lock"],
)
use_repo(nix_repo, "nixpkgs")

# Each package is materialised as its own external repository whose BUILD file
# we supply, because nixpkgs outputs are a directory of headers and libraries
# with no Bazel metadata in them. The BUILD files live in //third_party/nix so
# they are reviewable as ordinary source.
nix_pkg = use_extension("@rules_nixpkgs_core//extensions:package.bzl", "nix_pkg")
nix_pkg.attr(
    name = "nixpkgs_doctest",
    attr = "doctest",
    build_file = "//third_party/nix:doctest.BUILD.bazel",
)
use_repo(nix_pkg, "nixpkgs_doctest")
