# Bzlmod only. MODULE.bazel is the dependency manifest; WORKSPACE.bzlmod holds
# the one piece of setup that has no module extension yet.
common --enable_bzlmod

# Use the Nix-provided C++ toolchain rather than one autoconfigured from the
# ambient PATH. Both flags are needed: --extra_toolchains registers it for
# toolchain resolution, and --crosstool_top covers the legacy path that some
# rules still take.
build --crosstool_top=@nixpkgs_config_cc//:toolchain
build --host_platform=@rules_nixpkgs_core//platforms:host

# The C++ standard lives in the toolchain (cc_std in WORKSPACE.bzlmod), not
# here, so that it applies to every action rather than only to targets that
# did not override copts.

# Warnings the CMake build turns on per-target. Global here: a warning that is
# worth fixing in one module is worth fixing in all of them, and there is no
# vendored third-party source in this tree to exempt.
build --cxxopt=-Wall
build --cxxopt=-Wextra

# Show what a failing test actually printed, rather than only the path to a log
# file, and report per-target cached-vs-run status so the caching behaviour is
# visible.
test --test_output=errors
test --test_summary=detailed

# Keep the convenience symlinks out of the source root: the CMake build, the
# language server and the various tools under tools/ all walk this tree, and a
# bazel-out symlink pointing into the output base makes them walk the entire
# build cache. They are still reachable under .bazel/.
build --symlink_prefix=.bazel/
