{
    "version": 8,
    "configurePresets": [
        {
            "name": "Base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "YES"
            }
        },
        {
            "name": "clang",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_COMPILER": "clang"
            }
        },
        {
            "name": "Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS_DEBUG": "-O0 -g"
            },
            "inherits": [
                "Base",
                "clang"
            ]
        },
        {
            "name": "Coverage",
            "description": "Debug build with LLVM source-based coverage instrumentation, exporting one LCOV per test as well as the merged total.",
            "cacheVariables": {
                "ENABLE_TEST_COVERAGE": "ON",
                "ENABLE_PER_TEST_COVERAGE": "ON"
            },
            "inherits": [
                "Debug"
            ]
        },
        {
            "name": "Sanitize",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS_DEBUG": "-O0 -g -fsanitize=undefined -fsanitize=address"
            },
            "inherits": [
                "Base",
                "clang"
            ]
        },
        {
            "name": "Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            },
            "inherits": [
                "Base",
                "clang"
            ]
        },
        {
            "name": "Fuzz",
            "description": "AFL++ instrumented build, for running randomized tests under `TEST_RNG=afl`. Run them with the FuzzTest preset. -O0 is chosen because it prevents merging of CFG edges, which makes the fuzzer's job easier.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "afl-clang-fast++",
                "BUILD_FUZZERS": "ON",
                "CMAKE_CXX_FLAGS_DEBUG": "-O0 -g -fsanitize=address"
            },
            "inherits": [
                "Base"
            ]
        },
        {
            "name": "LibAfl",
            "description": "SanitizerCoverage-instrumented build, for running randomized tests under `TEST_RNG=libafl`. Run them with the LibAflTest preset. Needs no special compiler -- the instrumentation is stock clang's, and the fuzzer consuming it is the libafl-c shared library linked into the binary. -O0 for the same reason the Fuzz preset uses it: it prevents the tail-merging of failure paths that would flatten a coverage gradient.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_LIBAFL": "ON",
                "CMAKE_CXX_FLAGS_DEBUG": "-O0 -g -fsanitize-coverage=trace-pc-guard -fno-sanitize-link-runtime"
            },
            "inherits": [
                "Base",
                "clang"
            ]
        },
        {
            "name": "FuzzCmplog",
            "description": "CmpLog (redqueen) build of the same sources, passed to afl-fuzz as `-c`. Not a fuzzing target itself: afl-fuzz runs the Fuzz binary and consults this one to learn comparison operands.",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "-DCMPLOG_BUILD"
            },
            "environment": {
                "AFL_LLVM_CMPLOG": "1"
            },
            "inherits": [
                "Fuzz"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Coverage",
            "configurePreset": "Coverage"
        },
        {
            "name": "Sanitize",
            "configurePreset": "Sanitize"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "Fuzz",
            "configurePreset": "Fuzz"
        },
        {
            "name": "FuzzCmplog",
            "configurePreset": "FuzzCmplog",
            "environment": {
                "AFL_LLVM_CMPLOG": "1"
            }
        },
        {
            "name": "LibAfl",
            "configurePreset": "LibAfl"
        }
    ],
    "testPresets": [
        {
            "name": "DebugTest",
            "description": "",
            "displayName": "",
            "configurePreset": "Debug",
            "environment": {
                "TEST_RNG": "random"
            }
        },
        {
            "name": "CoverageTest",
            "description": "Run the LLVM-instrumented Coverage build.",
            "configurePreset": "Coverage",
            "environment": {
                "TEST_RNG": "random"
            }
        },
        {
            "name": "FuzzTest",
            "description": "Run the AFL++ instrumented build, including the end-to-end AFL self-test.",
            "configurePreset": "Fuzz",
            "environment": {
                "ASAN_OPTIONS": "detect_leaks=0:abort_on_error=1:symbolize=0"
            }
        },
        {
            "name": "LibAflTest",
            "description": "Run the SanitizerCoverage-instrumented build under the in-process LibAFL backend. Unlike FuzzTest this needs no external fuzzer process: TEST_RNG=libafl drives the whole search inside each test case.",
            "configurePreset": "LibAfl",
            "environment": {
                "TEST_RNG": "libafl"
            }
        },
        {
            "name": "SanitizeTest",
            "description": "",
            "displayName": "",
            "configurePreset": "Sanitize",
            "environment": {
                "ASAN_OPTIONS": "detect_leaks=0"
            },
            "output": {
                "verbosity": "extra"
            }
        },
        {
            "name": "Benchmark",
            "description": "",
            "displayName": "",
            "configurePreset": "Release",
            "environment": {
                "BENCHMARK": "1"
            }
        }
    ]
}
